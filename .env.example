# Required: create this in the Discord Developer Portal.
DISCORD_TOKEN=

# Railway PostgreSQL will provide this variable when we attach the database.
DATABASE_URL=

# Web dashboard OAuth2 settings from the same Discord application.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# Generate a long random value for signed dashboard sessions.
DASHBOARD_SESSION_SECRET=

# Keep true on Railway/production HTTPS. Set false only for local HTTP testing.
DASHBOARD_COOKIE_SECURE=true

# Environment safety. Production is the default if omitted.
APP_ENV=production

# Keep false in production. Destructive staging helpers require BOTH a non-production
# APP_ENV and this explicit opt-in.
ALLOW_DESTRUCTIVE_SMOKE_TESTS=false

# Set after a successful provider backup + staging restore drill (ISO date/time recommended).
# System Health shows backup readiness as unverified while this is blank.
BACKUP_VERIFIED_AT=
